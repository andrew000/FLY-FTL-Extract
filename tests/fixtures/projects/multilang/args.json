{
  "description": "several -l languages, --line-endings, --default-ftl-file",
  "runs": {
    "crlf": [
      "app",
      "locales",
      "-l",
      "en",
      "-l",
      "uk",
      "--line-endings",
      "crlf"
    ],
    "lf": [
      "app",
      "locales",
      "-l",
      "uk",
      "-l",
      "en",
      "--line-endings",
      "lf"
    ],
    "cr": [
      "app",
      "locales",
      "-l",
      "en",
      "--line-endings",
      "cr"
    ],
    "default_file": [
      "app",
      "locales",
      "-l",
      "en",
      "--default-ftl-file",
      "messages.ftl"
    ],
    "three": [
      "app",
      "locales",
      "-l",
      "en",
      "-l",
      "uk",
      "-l",
      "pl"
    ],
    "five": [
      "app",
      "locales",
      "-l",
      "en",
      "-l",
      "uk",
      "-l",
      "pl",
      "-l",
      "de",
      "-l",
      "fr"
    ]
  }
}
